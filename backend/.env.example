# Lyceum Connect backend — copy to .env and adjust. Never commit real secrets.

PORT=8090

# Leave empty to run with the in-memory dev store (no Postgres needed).
# Example: postgres://lyceum:lyceum@localhost:5432/lyceum_connect?sslmode=disable
DATABASE_URL=

# HS256 signing secret for session JWTs. Generate a strong value in production.
JWT_SECRET=dev-insecure-change-me
JWT_TTL_MINUTES=60

# Enables POST /api/auth/dev-login for local development. Set false in prod.
DEV_AUTH=true

# CORS origin(s) for the static frontend. Comma-separated for multiple dev ports.
ALLOWED_ORIGIN=http://localhost:8085

# Where the Entra callback redirects back with the session token (#token=...).
FRONTEND_URL=http://localhost:8085/login.html

# Microsoft Entra ID (Azure AD) SSO — leave blank to use dev-login instead.
# Register an app in Entra, add the redirect URI below as a Web redirect, and
# (optionally) define App Roles matching the RBAC role names.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=http://localhost:8090/api/auth/callback

# NVIDIA NIM. Powers three AI seams — all optional: the meeting analyzer
# (§13.1), the Dashboards insight Narrator (§13.6), and the Portal Bot tool-call
# router (§13.5, GLM-5.1). Unset => heuristic fallbacks are used everywhere.
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Slack Integration Hub (spec §6). Unset => log transport (events logged only).
# BotToken enables real per-channel posting; WebhookURL is a single-channel
# fallback; SigningSecret verifies inbound interactions.
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
