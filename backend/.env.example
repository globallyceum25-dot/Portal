# Lyceum Connect backend — copy to .env and adjust. Never commit real secrets.

PORT=8090

# Leave empty to run with the in-memory dev store (no Postgres needed).
# Example: postgres://lyceum:lyceum@localhost:5432/lyceum_connect?sslmode=disable
DATABASE_URL=

# HS256 signing secret for session JWTs. Generate a strong value in production.
JWT_SECRET=dev-insecure-change-me
JWT_TTL_MINUTES=60

# Enables POST /api/auth/dev-login for local development. Set false in prod.
DEV_AUTH=true

# CORS origin for the static frontend (live-server default).
ALLOWED_ORIGIN=http://localhost:8085

# Microsoft Entra ID (Azure AD) SSO — leave blank until the tenant app is set up.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=http://localhost:8090/api/auth/callback
